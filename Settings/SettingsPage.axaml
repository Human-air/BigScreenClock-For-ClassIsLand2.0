<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:cp="clr-namespace:Avalonia.Controls;assembly=Avalonia.Controls.ColorPicker"
             xmlns:ci="clr-namespace:ClassIsland.Core.MarkupExtensions;assembly=ClassIsland.Core"
             xmlns:cis="clr-namespace:ClassIsland.Core;assembly=ClassIsland.Core"
             xmlns:views="clr-namespace:EveningSelfStudyClock.Views"
             x:Class="EveningSelfStudyClock.Settings.SettingsPage">
    <UserControl.Styles>
        <!-- 矢量图标：用 CI 自带的 Lucide 图标字体，{ci:LI 图标名} 取字形 -->
        <Style Selector="TextBlock.icon">
            <Setter Property="FontFamily" Value="{x:Static cis:AppBase.LucideIconsFontFamily}"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
        </Style>
    </UserControl.Styles>
    <Grid ColumnDefinitions="*,360" Margin="12">

        <!-- ===== 左栏：设置（可滚动） =====
             每个区块是一张卡片，用的是 CI 设置页里 SettingsExpander 那套：
             卡片底 CardBackgroundFillColorDefaultBrush、1px 边框 CardStrokeColorDefaultBrush、
             圆角 ControlCornerRadius(4)；文字颜色同样绑 FluentAvalonia 主题键，随 CI 主题自动切换。
             卡片跟着窗口一起变宽，铺满整个设置区域（本页标了 [FullWidthPage]，
             CI 的页面标题也就固定靠左，左距 12 与这里的 12 对齐）。 -->
        <ScrollViewer Grid.Column="0" Padding="0,0,12,0">
            <StackPanel Spacing="12" Margin="0,8,0,8">

                <!-- 功能开关 -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="14,12">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="icon" Text="{ci:LI Settings}" FontSize="17"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="显示开关" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <CheckBox IsChecked="{Binding ShowDecibelMeter}" FontSize="14">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Classes="icon" Text="{ci:LI Mic}" FontSize="13"/>
                            <TextBlock Text="教室音量" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding ShowCourseInfo}" FontSize="14">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Classes="icon" Text="{ci:LI BookOpen}" FontSize="13"/>
                            <TextBlock Text="课程信息" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </CheckBox>
                    <!-- 课程信息子项：勾选「课程信息」后出现 -->
                    <CheckBox Margin="20,2,0,0" FontSize="13"
                              IsChecked="{Binding ShowBellTime}"
                              IsVisible="{Binding ShowCourseInfo}">
                        <TextBlock Text="显示精确打铃时间" FontSize="13" VerticalAlignment="Center"/>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding ShowNoisyCounter}" FontSize="14">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Classes="icon" Text="{ci:LI ChartColumn}" FontSize="13"/>
                            <TextBlock Text="吵闹计数" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </CheckBox>
                    <CheckBox IsChecked="{Binding ShowReminderPanel}" FontSize="14">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Classes="icon" Text="{ci:LI Bell}" FontSize="13"/>
                            <TextBlock Text="提醒显示" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </CheckBox>
                    <!-- 提醒子项：勾选「提醒显示」后出现 -->
                    <StackPanel Spacing="6" Margin="20,2,0,0"
                                IsVisible="{Binding ShowReminderPanel}">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowSpacing="2"
                              RowDefinitions="Auto,Auto,Auto,Auto">
                            <CheckBox Grid.Row="0" Grid.Column="0" IsChecked="{Binding ShowWeatherReminder}"
                                      FontSize="14">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Classes="icon" Text="{ci:LI Sun}" FontSize="13"/>
                                    <TextBlock Text="天气" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Grid.Row="0" Grid.Column="1" IsChecked="{Binding ShowAlertsReminder}"
                                      FontSize="14">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Classes="icon" Text="{ci:LI TriangleAlert}" FontSize="13"/>
                                    <TextBlock Text="预警" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Grid.Row="1" Grid.Column="0" IsChecked="{Binding ShowCountdownReminder}"
                                      FontSize="14">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Classes="icon" Text="{ci:LI Timer}" FontSize="13"/>
                                    <TextBlock Text="倒计时" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Grid.Row="1" Grid.Column="1" IsChecked="{Binding ShowTextReminder}"
                                      FontSize="14">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Classes="icon" Text="{ci:LI MessageSquare}" FontSize="13"/>
                                    <TextBlock Text="文本" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Grid.Row="2" Grid.Column="0" IsChecked="{Binding ShowRainReminder}"
                                      FontSize="14">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Classes="icon" Text="{ci:LI CloudRain}" FontSize="13"/>
                                    <TextBlock Text="降雨提醒" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Grid.Row="2" Grid.Column="1" IsChecked="{Binding ShowEmojiSubtitles}"
                                      FontSize="14">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Classes="icon" Text="{ci:LI Smile}" FontSize="13"/>
                                    <TextBlock Text="颜文字" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </CheckBox>
                            <CheckBox Grid.Row="3" Grid.Column="0" IsChecked="{Binding ShowCameraReminder}"
                                      FontSize="14">
                                <StackPanel Orientation="Horizontal" Spacing="5">
                                    <TextBlock Classes="icon" Text="{ci:LI Webcam}" FontSize="13"/>
                                    <TextBlock Text="摄像头占用" FontSize="14" VerticalAlignment="Center"/>
                                </StackPanel>
                            </CheckBox>
                            <StackPanel Grid.Row="3" Grid.Column="1" Spacing="4">
                                <CheckBox IsChecked="{Binding ShowEarthquakeReminder}"
                                          IsEnabled="{Binding IsEarthquakePluginAvailable}"
                                          FontSize="14"
                                          ToolTip.Tip="读「地震预警」插件的实时状态，在屏幕上方弹出横波倒计时与震中震级">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Classes="icon" Text="{ci:LI Activity}" FontSize="13"/>
                                        <TextBlock Text="地震预警" FontSize="14" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </CheckBox>
                                <!-- 没装「地震预警」插件时：开关置灰，下面说明原因 -->
                                <TextBlock FontSize="12" TextWrapping="Wrap"
                                           IsVisible="{Binding ShowEarthquakePluginHint}"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                           Text="启用地震预警需先安装 ClassIsland 插件「地震预警」"/>
                            </StackPanel>
                        </Grid>

                        <!-- 摄像头占用子项：勾选「摄像头占用」后出现 -->
                        <StackPanel Spacing="6" Margin="0,4,0,0" IsVisible="{Binding ShowCameraReminder}">
                            <TextBlock Text="勾选要提醒的摄像头，不勾选的不提醒。" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                            <ItemsControl ItemsSource="{Binding CameraDevices}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <CheckBox IsChecked="{Binding IsSelected}" FontSize="14"
                                                  Content="{Binding Name}"
                                                  ToolTip.Tip="{Binding PathTip}"/>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button Content="刷新设备列表" Click="RefreshCameras_Click"
                                    FontSize="13" HorizontalAlignment="Left"/>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="提醒字号" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                                <Slider x:Name="CameraAlertFontSlider" Grid.Column="1"
                                        Value="{Binding CameraAlertFontSize}" Minimum="15" Maximum="19"
                                        TickFrequency="1" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding CameraAlertFontSizeText}" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Width="40"
                                           TextAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <TextBlock Text="{Binding CameraHint}" FontSize="11" TextWrapping="Wrap"
                                       IsVisible="{Binding HasCameraHint}"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        </StackPanel>
                    </StackPanel>
                    <!-- 托盘菜单入口开关 -->
                    <CheckBox IsChecked="{Binding ShowTrayMenuEntry}" FontSize="14">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Classes="icon" Text="{ci:LI SquareMenu}" FontSize="13"/>
                            <TextBlock Text="托盘菜单显示「进入大屏时钟」" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </CheckBox>
                    <TextBlock Text="关闭后 CI 托盘右键菜单里不再出现该入口（下次打开菜单即生效）。" FontSize="11" Margin="20,0,0,0"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                </StackPanel>
                </Border>

                <!-- 目标课程 -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="14,12">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="icon" Text="{ci:LI ListChecks}" FontSize="17"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="触发课程" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="选择要触发的课程，可添加多个。" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    <ItemsControl ItemsSource="{Binding SelectedCourses}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Grid ColumnDefinitions="*,Auto" Margin="0,2" ColumnSpacing="6">
                                    <ComboBox ItemsSource="{Binding AllCourses}"
                                              SelectedItem="{Binding SelectedName}"
                                              FontSize="13" Padding="6,3"/>
                                    <Button Grid.Column="1" FontSize="13"
                                            Foreground="#d9493f" Background="Transparent"
                                            BorderThickness="0" Cursor="Hand" Padding="6,3"
                                            Command="{Binding RemoveCommand}">
                                        <TextBlock Classes="icon" Text="{ci:LI X}" FontSize="13"/>
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Button FontSize="13"
                            Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                            Background="{DynamicResource ControlFillColorSecondaryBrush}"
                            BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                            CornerRadius="6" Padding="8,5"
                            Cursor="Hand" Click="AddCourse_Click">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Classes="icon" Text="{ci:LI Plus}" FontSize="12"/>
                            <TextBlock Text="添加课程" FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                </Border>

                <!-- 运行 -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="14,12">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="icon" Text="{ci:LI Timer}" FontSize="17"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="运行" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <CheckBox IsChecked="{Binding PauseWhenMinimized}" FontSize="14">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Classes="icon" Text="{ci:LI Pause}" FontSize="13"/>
                            <TextBlock Text="最小化超过设定时间后暂停" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </CheckBox>
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8"
                          IsEnabled="{Binding PauseWhenMinimized}">
                        <Slider Grid.Column="0" Value="{Binding MinimizePauseMinutes}"
                                Minimum="1" Maximum="30" TickFrequency="1"
                                VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="1" Text="{Binding MinimizePauseMinutesText}"
                                   FontSize="12" Width="52" TextAlignment="Center" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                    </Grid>
                    <TextBlock Text="暂停后停止计时、音量检测、摄像头检测与防休眠；窗口不关，任务栏入口保留，点回即恢复。"
                               FontSize="11" TextWrapping="Wrap"
                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                </StackPanel>
                </Border>

                <!-- 音量检测 -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="14,12">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="icon" Text="{ci:LI Volume2}" FontSize="17"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="音量检测" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="使用系统默认麦克风采集" FontSize="11"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                    <TextBlock Text="等级阈值 (RMS)（范围 0.001~1.000）" FontSize="12"
                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                    <Grid ColumnDefinitions="Auto,*,Auto" RowSpacing="6" ColumnSpacing="8"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="安静" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                        <Slider Grid.Row="0" Grid.Column="1" Minimum="-3" Maximum="0" TickFrequency="0.1"
                                Value="{Binding DecibelQuietThresholdIndex}" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="0" Grid.Column="2" Text="{Binding DecibelQuietThresholdText}" FontSize="12" Padding="4" Width="70"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="良好" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                        <Slider Grid.Row="1" Grid.Column="1" Minimum="{Binding GoodThresholdSliderMin}" Maximum="0" TickFrequency="0.1"
                                Value="{Binding DecibelGoodThresholdIndex}" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="1" Grid.Column="2" Text="{Binding DecibelGoodThresholdText}" FontSize="12" Padding="4" Width="70"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="一般" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                        <Slider Grid.Row="2" Grid.Column="1" Minimum="{Binding NormalThresholdSliderMin}" Maximum="0" TickFrequency="0.1"
                                Value="{Binding DecibelNormalThresholdIndex}" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="2" Grid.Column="2" Text="{Binding DecibelNormalThresholdText}" FontSize="12" Padding="4" Width="70"/>
                        <TextBlock Grid.Row="3" Grid.Column="0" Text="吵闹" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                        <Slider Grid.Row="3" Grid.Column="1" Minimum="{Binding NoisyThresholdSliderMin}" Maximum="0" TickFrequency="0.1"
                                Value="{Binding DecibelNoisyThresholdIndex}" VerticalAlignment="Center"/>
                        <TextBox Grid.Row="3" Grid.Column="2" Text="{Binding DecibelNoisyThresholdText}" FontSize="12" Padding="4" Width="70"/>
                        <TextBlock Grid.Row="4" Grid.Column="0" Text="采样间隔" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                        <Slider Grid.Row="4" Grid.Column="1" Value="{Binding SamplingIntervalSeconds}"
                                Minimum="0.1" Maximum="1.0" TickFrequency="0.1" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="4" Grid.Column="2" Text="{Binding SamplingIntervalSecondsText}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Width="72" TextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="5" Grid.ColumnSpan="3"
                                   Text="超过吵闹 = 「嘈杂」；建议从小到大填写。采样间隔：麦克风每采集多长一段音频算一次读数（0.2 秒 = 每秒 5 次）"
                                   FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                   TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
                </Border>

                <!-- 记录参数 -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="14,12">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="icon" Text="{ci:LI Calculator}" FontSize="17"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="记录参数" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto" RowSpacing="6" ColumnSpacing="8"
                          RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto,Auto">
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="起算底线" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                        <Slider Grid.Row="0" Grid.Column="1" Value="{Binding NoisySustainSeconds}"
                                Minimum="0.5" Maximum="5" TickFrequency="0.1"/>
                        <TextBlock Grid.Row="0" Grid.Column="2" Text="{Binding NoisySustainSecondsText}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Width="56" TextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="回落窗口" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                        <Slider Grid.Row="1" Grid.Column="1" Value="{Binding FallWindowSeconds}"
                                Minimum="0" Maximum="15" TickFrequency="0.5"/>
                        <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding FallWindowSecondsText}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Width="56" TextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="保护时长" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                        <Slider Grid.Row="2" Grid.Column="1" Value="{Binding SkipFirstMinutes}"
                                Minimum="0" Maximum="10" TickFrequency="1"
                                IsEnabled="{Binding SkipFirst3Min}"/>
                        <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SkipFirstMinutesText}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Width="56" TextAlignment="Center" VerticalAlignment="Center"/>
                        <CheckBox Grid.Row="3" Grid.ColumnSpan="3" IsChecked="{Binding SkipFirst3Min}"
                                  FontSize="13">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Classes="icon" Text="{ci:LI ShieldCheck}" FontSize="12"/>
                                <TextBlock Text="上课初期保护（上课开始后前 N 分钟不计数）" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>
                        <CheckBox Grid.Row="4" Grid.ColumnSpan="3" IsChecked="{Binding EnableNoiseDebugLog}"
                                  FontSize="13">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Classes="icon" Text="{ci:LI Wrench}" FontSize="12"/>
                                <TextBlock Text="调试日志（输出 NoiseDebugLog.csv，用于收集真实数据校准阈值）" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </CheckBox>
                        <TextBlock Grid.Row="5" Grid.Column="0" Text="日志保留" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                        <Slider Grid.Row="5" Grid.Column="1" Value="{Binding LogRetentionDays}"
                                Minimum="1" Maximum="5" TickFrequency="1"/>
                        <TextBlock Grid.Row="5" Grid.Column="2" Text="{Binding LogRetentionDaysText}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Width="56" TextAlignment="Center" VerticalAlignment="Center"/>
                        <TextBlock Grid.Row="6" Grid.Column="0" Text="保留规则" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                        <StackPanel Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="16">
                            <RadioButton GroupName="LogKeepMode" Content="按记录时长" FontSize="13" VerticalAlignment="Center"
                                         IsChecked="{Binding LogKeepByDuration}"/>
                            <RadioButton GroupName="LogKeepMode" Content="按文件大小" FontSize="13" VerticalAlignment="Center"
                                         IsChecked="{Binding LogKeepBySize}"/>
                        </StackPanel>
                        <TextBlock Grid.Row="7" Grid.Column="0" Text="{Binding LogKeepLabel}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                        <Slider Grid.Row="7" Grid.Column="1" Value="{Binding LogKeepValue}"
                                Minimum="{Binding LogKeepMinimum}" Maximum="{Binding LogKeepMaximum}"
                                TickFrequency="{Binding LogKeepTick}"/>
                        <TextBlock Grid.Row="7" Grid.Column="2" Text="{Binding LogKeepValueText}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Width="64" TextAlignment="Center" VerticalAlignment="Center"/>
                        <Button Grid.Row="8" Grid.ColumnSpan="3" HorizontalAlignment="Left"
                                FontSize="13" FontWeight="Normal" Cursor="Hand"
                                Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                Background="{DynamicResource ControlFillColorSecondaryBrush}"
                                BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}"
                                CornerRadius="6" Padding="8,5" Click="OpenLogFolder_Click">
                            <StackPanel Orientation="Horizontal" Spacing="5">
                                <TextBlock Classes="icon" Text="{ci:LI FolderOpen}" FontSize="12"/>
                                <TextBlock Text="打开调试数据文件目录" FontSize="13" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Button>
                        <TextBlock Grid.Row="9" Grid.ColumnSpan="3"
                                   Text="测试完记得关闭本开关；记录时长/大小达不到上面设定的日志会在停止记录后自动删除，旧日志按天数清理"
                                   FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
                </Border>

                <!-- 外观 -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="14,12">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="icon" Text="{ci:LI Palette}" FontSize="17"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="外观" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="主题" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                        <ComboBox Grid.Column="1" SelectedIndex="{Binding ThemeModeIndex}" FontSize="13"
                                  MinWidth="150" HorizontalAlignment="Left"
                                  IsEnabled="{Binding IsAppearanceThemeEnabled}">
                            <ComboBoxItem Content="跟随 ClassIsland"/>
                            <ComboBoxItem Content="明亮"/>
                            <ComboBoxItem Content="黑暗"/>
                        </ComboBox>
                    </Grid>
                    <!-- 背景总开关：开了才启用下面这一整组（背景图 + 玻璃 + 背景主题），
                         此时上面那项「主题」整项失效、由下面「背景主题」说了算 -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="自定义背景" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                        <CheckBox Grid.Column="1" FontSize="13"
                                  IsChecked="{Binding BackgroundEnabled}" HorizontalAlignment="Left"/>
                    </Grid>
                    <!-- 开关关着时整组同时压暗：光靠 IsEnabled 只能让下拉、按钮变灰，
                         几行说明文字因为各自写了 Foreground，不会跟着变，看着像还能调 -->
                    <Expander HorizontalAlignment="Stretch"
                              IsExpanded="{Binding IsBackgroundSectionExpanded, Mode=TwoWay}"
                              IsEnabled="{Binding BackgroundEnabled}"
                              Opacity="{Binding BackgroundSectionOpacity}">
                        <Expander.Header>
                            <TextBlock Text="背景设置" FontSize="13"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                        </Expander.Header>
                        <StackPanel Spacing="8">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="背景主题" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                                <ComboBox Grid.Column="1" SelectedIndex="{Binding BackgroundThemeModeIndex}" FontSize="13"
                                          MinWidth="150" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="自动（跟着背景图）"/>
                                    <ComboBoxItem Content="暗底白字"/>
                                    <ComboBoxItem Content="亮底黑字"/>
                                </ComboBox>
                            </Grid>
                            <!-- 背景图片：选中的图会复制一份进插件配置目录 -->
                            <Grid ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="背景图片" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                                <TextBlock Grid.Column="1" Text="{Binding BackgroundImageSummary}" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                <Button Grid.Column="2" FontSize="13" CornerRadius="6" Padding="10,4"
                                        Cursor="Hand" Click="PickBackgroundImage_Click">
                                    <StackPanel Orientation="Horizontal" Spacing="5">
                                        <TextBlock Classes="icon" Text="{ci:LI FolderOpen}" FontSize="12"/>
                                        <TextBlock Text="选择图片" FontSize="13" VerticalAlignment="Center"/>
                                    </StackPanel>
                                </Button>
                                <Button Grid.Column="3" FontSize="13" CornerRadius="6" Padding="10,4"
                                        Cursor="Hand" Click="ClearBackgroundImage_Click">
                                    <TextBlock Text="清除" FontSize="13"/>
                                </Button>
                            </Grid>
                            <TextBlock Text="{Binding BackgroundImageHint}" FontSize="11"
                                       Foreground="{DynamicResource TextFillColorTertiaryBrush}" TextWrapping="Wrap"/>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="填充方式" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                                <ComboBox Grid.Column="1" SelectedIndex="{Binding BackgroundImageStretchIndex}" FontSize="13"
                                          MinWidth="150" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="铺满整屏（裁掉多余）"/>
                                    <ComboBoxItem Content="完整显示（两侧模糊补齐）"/>
                                    <ComboBoxItem Content="拉伸铺满"/>
                                </ComboBox>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="背景明暗" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                                <Slider Grid.Column="1" Value="{Binding BackgroundDim}" Minimum="-100" Maximum="100"
                                        TickFrequency="10" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding BackgroundDimText}" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Width="60" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                <TextBlock Grid.Column="0" Text="◯◯玻璃" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                                <ComboBox Grid.Column="1" SelectedIndex="{Binding GlassModeIndex}" FontSize="13"
                                          MinWidth="150" HorizontalAlignment="Left">
                                    <ComboBoxItem Content="关闭"/>
                                    <ComboBoxItem Content="半透明"/>
                                    <ComboBoxItem Content="磨砂"/>
                                    <ComboBoxItem Content="真•◯◯玻璃"/>
                                </ComboBox>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
                                  IsVisible="{Binding IsOpacityRowVisible}">
                                <TextBlock Grid.Column="0" Text="透明度" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                                <Slider Grid.Column="1" Value="{Binding GlassOpacity}" Minimum="0" Maximum="100"
                                        TickFrequency="5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding GlassOpacityText}" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Width="60" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
                                  IsVisible="{Binding IsGrainRowVisible}">
                                <TextBlock Grid.Column="0" Text="磨砂颗粒度" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                                <Slider Grid.Column="1" Value="{Binding GlassBlurRadius}" Minimum="1" Maximum="64"
                                        TickFrequency="4" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding GlassBlurRadiusText}" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Width="60" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
                                  IsVisible="{Binding IsLiquidRowVisible}">
                                <TextBlock Grid.Column="0" Text="折射强度" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                                <Slider Grid.Column="1" Value="{Binding GlassRefraction}" Minimum="0" Maximum="100"
                                        TickFrequency="5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding GlassRefractionText}" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Width="60" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
                                  IsVisible="{Binding IsLiquidRowVisible}">
                                <TextBlock Grid.Column="0" Text="雾面浓度" VerticalAlignment="Center"
                                           Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                                <Slider Grid.Column="1" Value="{Binding GlassFrost}" Minimum="0" Maximum="100"
                                        TickFrequency="5" VerticalAlignment="Center"/>
                                <TextBlock Grid.Column="2" Text="{Binding GlassFrostText}" FontSize="12"
                                           Foreground="{DynamicResource TextFillColorPrimaryBrush}" Width="60" TextAlignment="Center" VerticalAlignment="Center"/>
                            </Grid>
                        </StackPanel>
                    </Expander>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="时钟字号" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                        <Slider x:Name="ClockFontSlider" Grid.Column="1"
                                Value="{Binding ClockFontSize}" Minimum="60" Maximum="400"
                                TickFrequency="20" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding ClockFontSizeText}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Width="40" TextAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="课程信息字号" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                        <Slider x:Name="CourseInfoFontSlider" Grid.Column="1"
                                Value="{Binding CourseInfoFontSize}" Minimum="14" Maximum="72"
                                TickFrequency="2" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding CourseInfoFontSizeText}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Width="40" TextAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="计数字号" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                        <Slider x:Name="CountFontSlider" Grid.Column="1"
                                Value="{Binding CountFontSize}" Minimum="12" Maximum="72"
                                TickFrequency="2" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding CountFontSizeText}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Width="40" TextAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <!-- 上下位置：数值 = 该块中心落在主体区（去掉顶部提醒行与底部各行后剩下的那块）高度的百分之几 -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="时钟位置" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                        <!-- 上下限跟着大屏那边的限位走：拖到头就是屏幕上能到的最上/最下，不进死区 -->
                        <Slider x:Name="ClockPositionSlider" Grid.Column="1"
                                Minimum="{Binding ClockPositionMin}" Maximum="{Binding ClockPositionMax}"
                                Value="{Binding ClockPositionPercent}"
                                TickFrequency="5" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding ClockPositionPercentText}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Width="40" TextAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                        <TextBlock Grid.Column="0" Text="音量条位置" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                        <Slider x:Name="VolumePositionSlider" Grid.Column="1"
                                Minimum="{Binding VolumePositionMin}" Maximum="{Binding VolumePositionMax}"
                                Value="{Binding VolumePositionPercent}"
                                TickFrequency="5" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding VolumePositionPercentText}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Width="40" TextAlignment="Center" VerticalAlignment="Center"/>
                    </Grid>
                    <!-- 颜色选择：色块在每行最右，点击弹出 HSV 面板。切主题时这几个色会被写成该主题的默认值，之后仍可自己调 -->
                    <!-- 背景色不可调：它由主题定（明亮 = 白、黑暗 = 黑），不跟着主题走的话
                         切主题后整块只有底色没变，反而更别扭 -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Text="时钟字体颜色" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                        <TextBlock Grid.Column="1" Text="{Binding FontColorHex}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        <cp:ColorPicker Grid.Column="2" Color="{Binding FontColorValue}"
                                        IsAccentColorsVisible="False" Width="90" Height="28"
                                        HorizontalAlignment="Right">
                            <cp:ColorPicker.Content>
                                <Border Background="{Binding FontColorBrush}" CornerRadius="3"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"/>
                            </cp:ColorPicker.Content>
                        </cp:ColorPicker>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Text="进度条颜色" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                        <TextBlock Grid.Column="1" Text="{Binding ProgressColorHex}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        <cp:ColorPicker Grid.Column="2" Color="{Binding ProgressColorValue}"
                                        IsAccentColorsVisible="False" Width="90" Height="28"
                                        HorizontalAlignment="Right">
                            <cp:ColorPicker.Content>
                                <Border Background="{Binding ProgressColorBrush}" CornerRadius="3"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"/>
                            </cp:ColorPicker.Content>
                        </cp:ColorPicker>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Text="课程信息颜色" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                        <TextBlock Grid.Column="1" Text="{Binding CourseInfoColorHex}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        <cp:ColorPicker Grid.Column="2" Color="{Binding CourseInfoColorValue}"
                                        IsAccentColorsVisible="False" Width="90" Height="28"
                                        HorizontalAlignment="Right">
                            <cp:ColorPicker.Content>
                                <Border Background="{Binding CourseInfoColorBrush}" CornerRadius="3"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"/>
                            </cp:ColorPicker.Content>
                        </cp:ColorPicker>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Text="音量条文字颜色" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                        <TextBlock Grid.Column="1" Text="{Binding NoiseTitleColorHex}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        <cp:ColorPicker Grid.Column="2" Color="{Binding NoiseTitleColorValue}"
                                        IsAccentColorsVisible="False" Width="90" Height="28"
                                        HorizontalAlignment="Right">
                            <cp:ColorPicker.Content>
                                <Border Background="{Binding NoiseTitleColorBrush}" CornerRadius="3"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"/>
                            </cp:ColorPicker.Content>
                        </cp:ColorPicker>
                    </Grid>
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                        <TextBlock Grid.Column="0" Text="降水提醒颜色" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                        <TextBlock Grid.Column="1" Text="{Binding RainColorHex}" FontSize="12"
                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                   HorizontalAlignment="Right" VerticalAlignment="Center"/>
                        <cp:ColorPicker Grid.Column="2" Color="{Binding RainColorValue}"
                                        IsAccentColorsVisible="False" Width="90" Height="28"
                                        HorizontalAlignment="Right">
                            <cp:ColorPicker.Content>
                                <Border Background="{Binding RainColorBrush}" CornerRadius="3"
                                        BorderBrush="{DynamicResource ControlStrokeColorDefaultBrush}" BorderThickness="1"/>
                            </cp:ColorPicker.Content>
                        </cp:ColorPicker>
                    </Grid>
                </StackPanel>
                </Border>
                <!-- 规则说明 -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="14,12">
                <StackPanel Spacing="4">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="icon" Text="{ci:LI ScrollText}" FontSize="17"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="记录规则" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>
                    <TextBlock Text="• 一段噪音累计满「起算底线」秒才记一次（默认 1 秒），咳嗽、喷嚏等瞬时噪音不计数"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="• 一段内音量短暂回落到安静/良好（不超过「回落窗口」，默认 5 秒）又重新吵起，仍并成一次"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="• 一段噪音按一般/吵闹的时长占比归属：吵闹占一半及以上记「吵闹」，否则记「一般」"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    <TextBlock Text="• 开启「上课初期保护」后，上课开始后前 N 分钟不计数"
                               FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="5" Margin="0,6,0,0">
                        <TextBlock Classes="icon" Text="{ci:LI TriangleAlert}" FontSize="13"
                                   Foreground="#d97706"/>
                        <TextBlock Grid.Column="1" Text="免责声明：分贝记录仅供参考，可能受教室风扇、空调、开关门、桌椅移动、脚步声等环境杂音影响，不代表真实纪律状况。"
                                   FontSize="12" Foreground="#d97706" TextWrapping="Wrap"/>
                    </Grid>
                </StackPanel>
                </Border>

                <!-- 飞书推送 -->
                <Border Background="{DynamicResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1" CornerRadius="4" Padding="14,12">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Classes="icon" Text="{ci:LI Send}" FontSize="17"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                        <TextBlock Text="飞书推送" FontSize="17" FontWeight="Bold"
                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                   VerticalAlignment="Center"/>
                    </StackPanel>

                    <CheckBox IsChecked="{Binding EnableFeishuNotify}" FontSize="14">
                        <StackPanel Orientation="Horizontal" Spacing="5">
                            <TextBlock Classes="icon" Text="{ci:LI Bell}" FontSize="13"/>
                            <TextBlock Text="启用飞书推送（噪音提醒 / 进出大屏时钟）" FontSize="14" VerticalAlignment="Center"/>
                        </StackPanel>
                    </CheckBox>

                    <StackPanel Spacing="6" IsEnabled="{Binding EnableFeishuNotify}">
                        <TextBlock Text="Webhook 地址：飞书群 → 设置 → 群机器人 → 添加机器人 → 自定义机器人，复制其中的地址填到这里"
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBox Text="{Binding FeishuWebhookUrl}" FontSize="12" Padding="6,4"
                                 Watermark="https://open.feishu.cn/open-apis/bot/v2/hook/..."/>
                        <TextBlock Text="签名密钥（机器人开启「签名校验」时填，未开启留空）" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBox Text="{Binding FeishuSecret}" PasswordChar="●" FontSize="12" Padding="6,4"
                                 Watermark="签名密钥"/>
                        <TextBlock Text="设备 / 班级名称（多台机器区分用，可留空）" FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                        <TextBox Text="{Binding DeviceName}" FontSize="12" Padding="6,4" Watermark="如 高一(3)班"/>

                        <CheckBox IsChecked="{Binding FeishuNotifyNoise}" Content="推送噪音提醒（一般 / 吵闹）" FontSize="13"/>
                        <CheckBox IsChecked="{Binding FeishuNotifyNormal}" IsEnabled="{Binding FeishuNotifyNoise}"
                                  Content="「一般」等级也推送（关闭则只在「吵闹」时推送）" FontSize="13" Margin="20,0,0,0"/>
                        <CheckBox IsChecked="{Binding FeishuNotifyEnterExit}" Content="推送进入 / 退出大屏时钟" FontSize="13"/>
                        <CheckBox IsChecked="{Binding FeishuDirectConnection}"
                                  Content="直连（不走系统代理；插件发送超时可勾选）" FontSize="13"/>

                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="同级冷却" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                            <Slider Grid.Column="1" Value="{Binding FeishuCooldownSeconds}"
                                    Minimum="0" Maximum="600" TickFrequency="10" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding FeishuCooldownSecondsText}" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Width="66"
                                       TextAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                            <TextBlock Grid.Column="0" Text="请求超时" VerticalAlignment="Center"
                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}" FontSize="13"/>
                            <Slider Grid.Column="1" Value="{Binding FeishuTimeoutSeconds}"
                                    Minimum="5" Maximum="120" TickFrequency="5" VerticalAlignment="Center"/>
                            <TextBlock Grid.Column="2" Text="{Binding FeishuTimeoutSecondsText}" FontSize="12"
                                       Foreground="{DynamicResource TextFillColorPrimaryBrush}" Width="66"
                                       TextAlignment="Center" VerticalAlignment="Center"/>
                        </Grid>
                        <TextBlock Text="同级冷却：同一等级（一般 / 吵闹）两条消息的最小间隔，0 = 不限制，默认 30 秒。"
                                   FontSize="11" TextWrapping="Wrap"
                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>

                        <!-- 抓拍附图 -->
                        <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,8,0,0">
                            <StackPanel Spacing="8">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <TextBlock Classes="icon" Text="{ci:LI Camera}" FontSize="15"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                    <TextBlock Text="抓拍附图" FontSize="14" FontWeight="SemiBold"
                                               Foreground="{DynamicResource TextFillColorPrimaryBrush}"
                                               VerticalAlignment="Center"/>
                                </StackPanel>
                                <TextBlock Text="开启后，每次推送消息前自动抓拍一张教室照片一并发送。照片需要「飞书自建应用」凭据才能上传，未填写时自动降级为纯文字（照片仍会存到本地）。"
                                           FontSize="11" TextWrapping="Wrap"
                                           Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                <CheckBox IsChecked="{Binding EnableSnapshot}" Content="推送时自动抓拍并附带照片" FontSize="13"/>

                                <StackPanel Spacing="6" IsEnabled="{Binding EnableSnapshot}">
                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="摄像头" VerticalAlignment="Center" FontSize="13"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Cameras}"
                                                  SelectedItem="{Binding SelectedCamera}"
                                                  HorizontalAlignment="Stretch" PlaceholderText="（点右侧刷新扫描）"/>
                                        <Button Grid.Column="2" Content="刷新" Click="RefreshSnapshotCameras_Click"
                                                CornerRadius="6" Padding="8,4" Cursor="Hand"/>
                                    </Grid>

                                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                        <TextBlock Grid.Column="0" Text="分辨率" VerticalAlignment="Center" FontSize="13"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                        <ComboBox Grid.Column="1" ItemsSource="{Binding Resolutions}"
                                                  SelectedItem="{Binding SelectedResolution}"
                                                  HorizontalAlignment="Stretch"/>
                                    </Grid>

                                    <StackPanel Orientation="Horizontal" Spacing="10">
                                        <Button Content="测试抓拍" Click="TestSnapshot_Click"
                                                CornerRadius="6" Padding="10,5" Cursor="Hand"/>
                                        <TextBlock Text="{Binding SnapshotStatus}" VerticalAlignment="Center" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                    </StackPanel>

                                    <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                            BorderThickness="1" CornerRadius="6" Padding="2"
                                            HorizontalAlignment="Left">
                                        <Image Source="{Binding SnapshotPreview}" Width="240" Height="135"
                                               Stretch="UniformToFill"/>
                                    </Border>

                                    <TextBlock Text="飞书自建应用凭据（上传照片用；不填则只发文字）" FontSize="12" Margin="0,6,0,0"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                    <TextBox Text="{Binding FeishuAppId}" FontSize="12" Padding="6,4"
                                             Watermark="App ID，如 cli_a1b2c3d4e5f6g7h8"/>
                                    <TextBox Text="{Binding FeishuAppSecret}" PasswordChar="●" FontSize="12" Padding="6,4"
                                             Watermark="App Secret"/>
                                    <TextBlock Text="配置路径：飞书开放平台 → 创建企业自建应用 → 权限管理开通「获取与上传图片 im:resource」→ 创建版本并发布 → 把 App ID / App Secret 填到上面。不需要把应用拉进群。"
                                               FontSize="11" TextWrapping="Wrap"
                                               Foreground="{DynamicResource TextFillColorTertiaryBrush}"/>
                                </StackPanel>

                                <!-- ===== 现场录音 / 打小报告 ===== -->
                                <Border BorderBrush="{DynamicResource CardStrokeColorDefaultBrush}"
                                        BorderThickness="0,1,0,0" Margin="0,6,0,0" Padding="0,8,0,0">
                                    <StackPanel Spacing="8">
                                        <TextBlock Text="🎙 现场录音" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}"/>
                                        <TextBlock Text="Webhook 机器人发不了文件，录音走「自建应用」发到群：先填好上方应用凭据，开通「上传或下载文件（im:resource）」「接收群消息（im:message）」「获取群组信息（im:chat）」权限并发布版本，再把机器人拉进群后点「查询群列表」选择目标群。未选群时录音只保存本地。"
                                                   FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   TextWrapping="Wrap"/>

                                        <CheckBox IsChecked="{Binding EnableNoiseAudioRecord}" FontSize="13"
                                                  Content="检测到吵闹后自动录音并发送到群"/>

                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8"
                                              IsEnabled="{Binding EnableNoiseAudioRecord}">
                                            <TextBlock Grid.Column="0" Text="录音时长" VerticalAlignment="Center" FontSize="13"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <Slider Grid.Column="1" Value="{Binding NoiseRecordSeconds}"
                                                    Minimum="10" Maximum="60" TickFrequency="5" VerticalAlignment="Center"/>
                                            <TextBlock Grid.Column="2" Text="{Binding NoiseRecordSecondsText}" FontSize="12"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                       Width="56" TextAlignment="Center" VerticalAlignment="Center"/>
                                        </Grid>

                                        <TextBlock Text="录音发送到哪个群？（机器人所在群）" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}" Margin="0,4,0,0"/>
                                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                            <ComboBox Grid.Column="0" ItemsSource="{Binding Chats}"
                                                      SelectedItem="{Binding SelectedChat}"
                                                      HorizontalAlignment="Stretch"
                                                      PlaceholderText="（点右侧「查询群列表」选择）"/>
                                            <Button Grid.Column="1" Content="🔍 查询群列表" Click="QueryChats_Click"
                                                    CornerRadius="6" Padding="8,4" Cursor="Hand"/>
                                        </Grid>
                                        <TextBlock Text="{Binding FeishuChatIdText}" FontSize="11"
                                                   Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   TextWrapping="Wrap"/>
                                        <TextBlock Text="{Binding ChatQueryStatus}" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"/>

                                        <!-- ===== 快捷键打小报告 ===== -->
                                        <TextBlock Text="📣 快捷键打小报告" FontSize="14" FontWeight="SemiBold"
                                                   Foreground="{DynamicResource TextFillColorPrimaryBrush}" Margin="0,8,0,0"/>
                                        <TextBlock Text="系统级全局热键：无论在哪个界面，按下即自动 抓拍教室照片 → 发橙色报告卡片 → 录 10 秒现场音频 → 发送录音到群。10 秒冷却防误触；照片/录音同样依赖上方应用凭据与群选择。"
                                                   FontSize="11" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                                                   TextWrapping="Wrap"/>

                                        <CheckBox IsChecked="{Binding EnableSnitch}" FontSize="13"
                                                  Content="启用打小报告快捷键"/>

                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                            <TextBlock Grid.Column="0" Text="快捷键" VerticalAlignment="Center" FontSize="13"
                                                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
                                            <TextBox Grid.Column="1" Text="{Binding SnitchHotkey}" FontSize="12" Padding="6,4"
                                                     Watermark="Ctrl+Alt+R（Ctrl/Alt/Shift/Win + 字母/数字/F1~F24）"/>
                                            <Button Grid.Column="2" Content="🚨 测试" Click="TestSnitch_Click"
                                                    CornerRadius="6" Padding="8,4" Cursor="Hand"/>
                                        </Grid>
                                        <TextBlock Text="{Binding SnitchTestStatus}" FontSize="12"
                                                   Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                                                   TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Border>

                                <StackPanel Orientation="Horizontal" Spacing="10" Margin="0,4,0,0">
                                    <Button Content="测试发送" Click="TestFeishu_Click" CornerRadius="6" Padding="10,5" Cursor="Hand"/>
                                    <TextBlock Text="{Binding FeishuTestStatus}" VerticalAlignment="Center" FontSize="12"
                                               Foreground="{DynamicResource TextFillColorSecondaryBrush}" TextWrapping="Wrap"/>
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ===== 右栏：实时预览（置顶不滚动）+ 进入全屏时钟 =====
             预览不是照着重画的小样，而是把大屏那面墙（ClockSurface）本身等比缩进这个框里：
             布局、字号、颜色、时钟与音量条的位置都出自同一份 XAML，不可能和大屏对不上。
             尺寸按大屏那块屏幕的长宽比算，所以各种比例下看到的都是真实观感。 -->
        <StackPanel Grid.Column="1" Spacing="8" VerticalAlignment="Top" Margin="4,8,0,0">
            <TextBlock Text="预览" FontSize="12" Foreground="{DynamicResource TextFillColorSecondaryBrush}"/>
            <Border Background="{Binding BackgroundColorBrush}" CornerRadius="12" ClipToBounds="True">
                <Viewbox Stretch="Uniform">
                    <!-- Panel 只负责给出「大屏那块屏幕的尺寸」；ClockSurface 拿的是 ViewModel。
                         分开写是因为 ClockSurface 的 DataContext 一旦换成 ViewModel，
                         它自己身上的宽高绑定就会跑去 ViewModel 上找 PreviewWidth 了。 -->
                    <Panel Width="{Binding PreviewWidth}" Height="{Binding PreviewHeight}">
                        <views:ClockSurface IsPreview="True" IsHitTestVisible="False"
                                            BackdropCornerRadius="12"
                                            DataContext="{Binding PreviewVm}"/>
                    </Panel>
                </Viewbox>
            </Border>
            <Button FontSize="15" FontWeight="Bold"
                    Foreground="#ffffff" Background="#2e7d32"
                    CornerRadius="8" Padding="10,8"
                    Cursor="Hand" Click="TestButton_Click"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Center">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center">
                    <TextBlock Classes="icon" Text="{ci:LI Play}" FontSize="15" Foreground="#ffffff"/>
                    <TextBlock Text="进入全屏时钟" FontSize="15" FontWeight="Bold" Foreground="#ffffff" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</UserControl>
