<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="EveningSelfStudyClock.Views.FullScreenClockWindow"
        xmlns:views="clr-namespace:EveningSelfStudyClock.Views"
        Title="{Binding WindowTitle}"
        WindowState="FullScreen"
        SystemDecorations="None"
        ShowInTaskbar="True"
        CanResize="False"
        Background="{Binding BackgroundColor}">

    <!-- 内容全在 ClockSurface 里：设置页的预览放的是同一个控件，只把 IsPreview 打开。
         窗口这边只管窗口自己的事（全屏、躲鼠标、Esc/F11 退出）。 -->
    <views:ClockSurface x:Name="Surface"/>
</Window>
