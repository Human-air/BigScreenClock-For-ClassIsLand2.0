<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="EveningSelfStudyClock.Views.ClockSurface"
             xmlns:ci="clr-namespace:ClassIsland.Core.MarkupExtensions;assembly=ClassIsland.Core"
             xmlns:cis="clr-namespace:ClassIsland.Core;assembly=ClassIsland.Core"
             xmlns:converters="using:Avalonia.Data.Converters"
             xmlns:views="clr-namespace:EveningSelfStudyClock.Views"
             FontFamily="Microsoft YaHei,SimHei,sans-serif">

    <UserControl.Styles>
        <!-- 矢量图标：用 CI 自带的 Lucide 图标字体（写死的用 {ci:LI 图标名}，
             随数据变化的如天气/档位由 VM 算出字形绑定 Text） -->
        <Style Selector="TextBlock.icon">
            <Setter Property="FontFamily" Value="{x:Static cis:AppBase.LucideIconsFontFamily}"/>
        </Style>
    </UserControl.Styles>

    <!-- 大屏时钟的全部内容。独立成一个 UserControl 是为了让设置页的预览能直接放一份同样的布局：
         预览不再是照着重画一遍的小样，而是这份布局本身等比缩到预览框里，
         字号、颜色、位置必然和大屏一致（不用两处同步改）。 -->
    <!-- 透明底色：半屏时露出来的那一半也得能接住点击（三击黑屏区退出半屏），
         默认的空 Grid 不参与命中测试，点了什么也收不到。 -->
    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <!-- 底部全宽课程进度带 -->
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 可见区域：全屏时铺满整窗；左/右半屏时只占一条（宽度由设置里的百分比定）。
             窗口本身仍然全屏——Esc/F11、防休眠、焦点都是窗口的事，画面只是收在能看见的那一条里。
             背景层、内容、底部进度带都放进这一层，玻璃也跟着只烘这一条，比铺满整屏省内存。 -->
        <Grid x:Name="Shell">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 背景层：自定义背景图 + 明暗遮罩 + 各组件底下的玻璃。
                 压在全部内容下面、跨越两行，不参与布局（组件的 Margin / 实测尺寸一个都没动，
                 ApplyBodyPositions 那套定位与写回不受影响）。要垫玻璃的组件在 code-behind 里登记。 -->
            <views:BackdropLayer x:Name="Backdrop" Grid.Row="0" Grid.RowSpan="2"/>

            <!-- 主内容（原有布局，Margins 保持不变） -->
            <Grid x:Name="MainContent" Grid.Row="0" RowDefinitions="Auto,*,Auto"
                  Margin="40,30,40,18">

            <!-- 顶部第一行：主位提醒块（天气 + 可并入的降雨/倒计时/文本，颜文字在各块正下方）+ 预警详情弹幕（自适应）+ 日期。
                 合并规则（VM 的 UpdateReminderMerge）：
                 - 天气固定第一行主位，与弹幕同行；
                 - 与天气合并优先级 降雨提醒 > 倒计时 > 文本，总宽 ≤ 屏幕 1/3 才并入，放不下该项留提醒面板；
                 - 无天气时主位由倒计时顶替，再无就文本框；
                 - 天气预警始终单开一行/多行（面板），不在顶部行。 -->
            <Grid x:Name="HeaderGrid" Grid.Row="0" RowDefinitions="Auto,Auto"
                  ColumnDefinitions="Auto,*,Auto">
                <!-- Spacing 与 VM 里 UpdateReminderMerge 的 spacing 常量必须一致：
                     玻璃底比文字左右各多占 12，间距不够的话相邻两块玻璃会贴在一起连成一条 -->
                <StackPanel x:Name="HeaderLeft" Grid.Column="0" Orientation="Horizontal" Spacing="36" VerticalAlignment="Center">
                    <!-- 天气块（含正下方颜文字）：当前天气是雨雪时整块转成降水色（默认蓝） -->
                    <StackPanel x:Name="WeatherBlock" Spacing="2" IsVisible="{Binding ShowWeatherInFirstRow}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="icon" Text="{Binding WeatherIcon}" FontSize="20" VerticalAlignment="Center"
                                       Foreground="{Binding WeatherBrush}"/>
                            <TextBlock Text="{Binding WeatherText}" FontSize="19" FontWeight="Bold"
                                       Foreground="{Binding WeatherBrush}" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                        </StackPanel>
                        <TextBlock Text="{Binding WeatherSubtitle}" FontSize="11" Foreground="{Binding Chrome.TextSecondary}"
                                   IsVisible="{Binding HasWeatherSubtitle}" Margin="2,0,0,0"/>
                    </StackPanel>
                    <!-- 降雨块（并入第一行时；含正下方颜文字）：用降水色 -->
                    <StackPanel x:Name="RainBlock" Spacing="2" IsVisible="{Binding ShowRainMergedInFirstRow}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="icon" Text="{ci:LI CloudRain}" FontSize="20" VerticalAlignment="Center"
                                       Foreground="{Binding RainColorBrush}"/>
                            <TextBlock Text="{Binding RainReminderTitle}" FontSize="19" FontWeight="Bold"
                                       Foreground="{Binding RainColorBrush}" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                        </StackPanel>
                        <TextBlock Text="{Binding RainSubtitle}" FontSize="11" Foreground="{Binding Chrome.TextSecondary}"
                                   IsVisible="{Binding HasRainSubtitle}" Margin="2,0,0,0"/>
                    </StackPanel>
                    <!-- 倒计时块（并入第一行时；无天气时作主位；含正下方颜文字） -->
                    <StackPanel x:Name="CountdownBlock" Spacing="2" IsVisible="{Binding ShowCountdownMergedInFirstRow}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="icon" Text="{ci:LI Timer}" FontSize="20" VerticalAlignment="Center"
                                       Foreground="{Binding Chrome.TextPrimary}"/>
                            <TextBlock Text="{Binding CountdownText}" FontSize="19" FontWeight="Bold"
                                       Foreground="{Binding Chrome.Countdown}" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                        </StackPanel>
                        <TextBlock Text="{Binding CountdownSubtitle}" FontSize="11" Foreground="{Binding Chrome.TextSecondary}"
                                   IsVisible="{Binding HasCountdownSubtitle}" Margin="2,0,0,0"/>
                    </StackPanel>
                    <!-- 文本块（并入第一行时；无天气且无倒计时时作主位） -->
                    <StackPanel x:Name="ReminderTextBlock" Orientation="Horizontal" Spacing="6" IsVisible="{Binding ShowTextMergedInFirstRow}">
                        <!-- 颜色 / 字号跟着 CI 主界面上的文本组件走（没自定义颜色时用主题正文色） -->
                        <TextBlock Text="{Binding ReminderText}" FontSize="{Binding ReminderTextFontSize}" FontWeight="Bold"
                                   Foreground="{Binding ReminderTextBrush}" VerticalAlignment="Center" TextWrapping="NoWrap"/>
                    </StackPanel>
                </StackPanel>
                <ScrollViewer x:Name="AlertDetailScroll" Grid.Column="1"
                              HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled"
                              Margin="28,0,0,0" VerticalAlignment="Center"
                              IsVisible="{Binding HasExpandedAlert}"
                              SizeChanged="DetailScroll_SizeChanged">
                    <TextBlock Text="{Binding ExpandedAlertDetail}" FontSize="16" Foreground="{Binding Chrome.TextBody}"
                               TextWrapping="NoWrap" VerticalAlignment="Center"/>
                </ScrollViewer>
                <StackPanel x:Name="DateBlock" Grid.Column="2" Margin="28,0,0,0" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="{Binding CurrentDate}" FontSize="22" Foreground="{Binding Chrome.TextMuted}"
                               HorizontalAlignment="Right" PointerPressed="DateText_PointerPressed"/>
                    <TextBlock Text="{Binding DateSubtitle}" FontSize="11" Foreground="{Binding Chrome.TextSecondary}"
                               HorizontalAlignment="Right" IsVisible="{Binding HasDateSubtitle}"/>
                </StackPanel>
            </Grid>

            <!-- 主体：时钟、音量条及可选的中间课程信息按实际尺寸上下定位。 -->
            <Grid Grid.Row="1" x:Name="BodyArea">
                <!-- 时间：字体跟随 CI 主界面字体，数字用表格宽度（tnum）免得秒数跳动时整行抖 -->
                <!-- 外面套一层 Viewbox（只缩不放大）：半屏 / 窄区域里时钟比可见宽度还宽时自动缩到放得下；
                     全屏时就是自然大小，一个像素都不缩。 -->
                <Viewbox x:Name="ClockBox" HorizontalAlignment="Center" VerticalAlignment="Top"
                         Stretch="Uniform" StretchDirection="DownOnly">
                    <TextBlock x:Name="ClockText" Text="{Binding CurrentTime}"
                               FontSize="{Binding ClockFontSize}"
                               FontWeight="Bold"
                               Foreground="{Binding FontColor}"
                               FontFamily="{Binding ClockFontFamily}"
                               FontFeatures="{Binding ClockFontFeatures}"
                               HorizontalAlignment="Center" VerticalAlignment="Top"/>
                </Viewbox>

                <!-- 教室音量：无背景「横向轨道 + 分段刻度」仪表盘式条（宽度跟随时间字体） -->
                <StackPanel x:Name="VolumePanel" Spacing="8" Width="{Binding #ClockBox.Bounds.Width, FallbackValue=640}"
                            HorizontalAlignment="Center" VerticalAlignment="Top"
                            IsVisible="{Binding ShowDecibelMeter}">
                    <!-- 为中间状态保留一半宽度。窄屏时各区分别缩字，完整保留保护时间。 -->
                    <Grid x:Name="VolumeTitleRow" ColumnDefinitions="1*,2*,1*" Height="26">
                        <Viewbox HorizontalAlignment="Left" VerticalAlignment="Center" StretchDirection="DownOnly">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <TextBlock Classes="icon" Text="{ci:LI Megaphone}" FontSize="20"
                                           Foreground="{Binding NoiseTitleColor}" VerticalAlignment="Center"/>
                                <TextBlock Text="教室音量" FontSize="20" FontWeight="Bold"
                                           Foreground="{Binding NoiseTitleColor}" VerticalAlignment="Center"/>
                            </StackPanel>
                        </Viewbox>
                        <Viewbox x:Name="MeterRecordingStatus" Grid.Column="1"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 StretchDirection="DownOnly" IsVisible="{Binding RecordingInMeterTitle}">
                            <TextBlock Text="{Binding RecordingText}" FontFeatures="tnum"
                                       Foreground="{Binding RecordingForeground}" FontSize="20" FontWeight="Bold"/>
                        </Viewbox>
                        <Viewbox x:Name="PreviewRecordingPlaceholder" Grid.Column="1" IsVisible="False"
                                 HorizontalAlignment="Center" VerticalAlignment="Center" StretchDirection="DownOnly">
                            <TextBlock Text="正在记录：一般" Foreground="{Binding RecordingForeground}"
                                       FontSize="20" FontWeight="Bold"/>
                        </Viewbox>
                        <Viewbox Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center" StretchDirection="DownOnly">
                            <TextBlock Text="{Binding NoiseLevelText}" FontSize="18" FontWeight="Bold"
                                       Foreground="{Binding NoiseLevelTextBrush}"/>
                        </Viewbox>
                    </Grid>
                    <!-- 轨道 + 分段刻度块（竖向实心矩形，略高于轨道、从轨道中突出） -->
                    <Grid ColumnDefinitions="1*,3,1*,3,1*,3,1*,3,1*" Height="16">
                        <ProgressBar Grid.ColumnSpan="9" Minimum="0" Maximum="100" Value="{Binding AnimatedProgress}"
                                     VerticalAlignment="Center" Height="5"
                                     Foreground="{Binding NoiseLevelFillBrush}"
                                     Background="{Binding NoiseLevelTrackBrush}">
                            <ProgressBar.Template>
                                <ControlTemplate TargetType="ProgressBar">
                                    <Grid>
                                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}"/>
                                        <!-- 必须靠左：ProgressBar 会按百分比给这块写死 Width，而默认 Stretch 的
                                             Border 在「定宽 + 拉伸」下会被居中，填充条就整体偏右半格（到 40 时看着像 50）。 -->
                                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                                Background="{TemplateBinding Foreground}"/>
                                    </Grid>
                                </ControlTemplate>
                            </ProgressBar.Template>
                        </ProgressBar>
                        <Rectangle Grid.Column="1" Width="3" Height="13" Fill="{Binding Chrome.Divider}" VerticalAlignment="Center" RadiusX="1.5"/>
                        <Rectangle Grid.Column="3" Width="3" Height="13" Fill="{Binding Chrome.Divider}" VerticalAlignment="Center" RadiusX="1.5"/>
                        <Rectangle Grid.Column="5" Width="3" Height="13" Fill="{Binding Chrome.Divider}" VerticalAlignment="Center" RadiusX="1.5"/>
                        <Rectangle Grid.Column="7" Width="3" Height="13" Fill="{Binding Chrome.Divider}" VerticalAlignment="Center" RadiusX="1.5"/>
                    </Grid>
                    <!-- 五档文字：当前档位高亮+放大+档位色，其余淡化 -->
                    <ItemsControl ItemsSource="{Binding NoiseLevelSlots}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="5"/>
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Text}" Foreground="{Binding TextBrush}" FontWeight="Bold"
                                           HorizontalAlignment="Center"
                                           Opacity="{Binding TextOpacity}" FontSize="{Binding TextFontSize}"/>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Grid>

            <!-- 底部：计数（左）/ 课程信息（正中）/ 按钮（右）同一行、同一高度。
                 中间列 Auto、左右两列都是 * —— 两边星列平分剩余空间，课程信息才落在屏幕正中，
                 否则会被更宽的左边计数推歪。两边星列放不下各自那份内容时，由 Viewbox 等比缩字
                 （只缩不放大），既不越界压到邻居上，也不会被列宽裁掉。 -->
            <Grid x:Name="FooterGrid" Grid.Row="2" RowDefinitions="Auto,Auto"
                  ColumnDefinitions="*,Auto,*" Margin="0,6,0,0">
                <!-- 吵闹计数（分段着色：一般=琥珀，吵闹=红）+ 实时「正在记录」提示。
                     鼠标悬停上方时在计数区上方弹出记录规则 -->
                <Border Grid.Column="0" VerticalAlignment="Center" ClipToBounds="True"
                        TextElement.FontSize="{Binding CountFontSize}"
                        x:Name="CounterAreaBorder"
                        PointerEntered="CounterArea_PointerEntered"
                        PointerExited="CounterArea_PointerExited">
                    <!-- 整条按同一比例缩小，计数和状态都能在左下角完整显示。 -->
                    <Viewbox x:Name="CounterStrip" HorizontalAlignment="Left" VerticalAlignment="Center"
                             StretchDirection="DownOnly">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <!-- 设置页预览专用：没有课程时用示例计数展示字号。 -->
                            <StackPanel x:Name="PreviewCounterPlaceholder" Orientation="Horizontal"
                                        IsVisible="False" VerticalAlignment="Center">
                                <TextBlock Text="一般 3 次" FontWeight="Bold" Foreground="{Binding CountNormalForeground}"/>
                                <TextBlock Text="吵闹 1 次" FontWeight="Bold" Margin="16,0,0,0"
                                           Foreground="{Binding CountNoisyForeground}"/>
                            </StackPanel>
                            <ItemsControl ItemsSource="{Binding NoisyDisplaySegments}" VerticalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal"/>
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Classes="icon" Text="{Binding Icon}"
                                                       IsVisible="{Binding HasIcon}"
                                                       Foreground="{Binding Foreground}"
                                                       VerticalAlignment="Center"
                                                       Margin="16,0,6,0"/>
                                            <TextBlock Text="{Binding Text}" Foreground="{Binding Foreground}"
                                                       FontWeight="Bold"/>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <TextBlock Text="{Binding RecordingText}" FontFeatures="tnum"
                                       Foreground="{Binding RecordingForeground}" FontWeight="Bold"
                                       IsVisible="{Binding RecordingInCounter}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Viewbox>
                </Border>
                <!-- 课程信息：与计数、按钮同处一行，居中对齐到屏幕正中。
                     最多占整行一半宽（CourseInfoMaxWidth，窗口按尺寸算），比这还长就由 Viewbox 等比缩字
                     （只缩不放大）——开了「显示精确打铃时间」把文字拉长也不会被列宽裁掉。 -->
                <Viewbox x:Name="CourseInfoBox" Grid.Column="1" Margin="24,0"
                         HorizontalAlignment="Center" VerticalAlignment="Center"
                         Stretch="Uniform" StretchDirection="DownOnly"
                         MaxWidth="{Binding CourseInfoMaxWidth}"
                         IsVisible="{Binding ShowCourseInfo}">
                    <Panel>
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Text="{Binding CourseInfoText}"
                                       FontSize="{Binding CourseInfoFontSize}" FontWeight="Bold"
                                       Foreground="{Binding CourseInfoColor}"/>
                            <Grid IsVisible="{Binding HasCourseTime}" VerticalAlignment="Center">
                                <TextBlock Text="{Binding CourseTimeWidthSample}" Opacity="0" IsHitTestVisible="False"
                                           AutomationProperties.AccessibilityView="Raw" FontFeatures="tnum"
                                           FontSize="{Binding CourseInfoFontSize}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding CourseTimeText}" FontFeatures="tnum" HorizontalAlignment="Left"
                                           FontSize="{Binding CourseInfoFontSize}" FontWeight="Bold"
                                           Foreground="{Binding CourseInfoColor}"/>
                            </Grid>
                        </StackPanel>
                        <!-- 设置页预览专用：没在上课时假装有课程信息，
                             否则「课程信息字号」在预览里根本看不出效果 -->
                        <TextBlock x:Name="PreviewCoursePlaceholder" IsVisible="False"
                                   Text="晚自习（1）"
                                   FontSize="{Binding CourseInfoFontSize}" FontWeight="Bold"
                                   Foreground="{Binding CourseInfoColor}"/>
                    </Panel>
                </Viewbox>

                <StackPanel x:Name="ButtonBar" Grid.Column="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"
                            HorizontalAlignment="Right">
                    <!-- 快速设置：不用退出大屏、也不用切回 CI 设置窗口，就在这里把这一面墙调明白。
                         只做图标（这里本来就挤，文字交给悬停提示） -->
                    <Button x:Name="SettingsButton"
                            FontSize="15" Foreground="{Binding Chrome.ButtonForeground}"
                            Background="{Binding Chrome.ButtonBackground}" BorderThickness="0"
                            CornerRadius="6" Padding="10,6"
                            Cursor="Hand"
                            ToolTip.Tip="设置"
                            ClickMode="Press"
                            Click="SettingsButton_Click">
                        <TextBlock Classes="icon" Text="{ci:LI Settings}" FontSize="16"
                                   Foreground="{Binding Chrome.ButtonForeground}" VerticalAlignment="Center"/>
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="{Binding Chrome.ButtonHover}"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    <!-- 触屏按下即执行，避免抬手时指尖滑出小按钮导致点击被取消。
                         交给 Button 自身处理 ClickMode，保留键盘操作且不叠加触摸事件处理器。 -->
                    <Button x:Name="MinimizeButton"
                            FontSize="15" Foreground="{Binding Chrome.ButtonForeground}"
                            Background="{Binding Chrome.ButtonBackground}" BorderThickness="0"
                            CornerRadius="6" Padding="12,6"
                            ClickMode="Press"
                            Cursor="Hand"
                            Click="MinimizeButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="icon" Text="{ci:LI Minus}" FontSize="15"
                                       Foreground="{Binding Chrome.ButtonForeground}" VerticalAlignment="Center"/>
                            <TextBlock Text="最小化" FontSize="15" Foreground="{Binding Chrome.ButtonForeground}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="{Binding Chrome.ButtonHover}"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                    <Button x:Name="ExitButton"
                            FontSize="15" Foreground="{Binding Chrome.ButtonForeground}"
                            Background="{Binding Chrome.ButtonBackground}" BorderThickness="0"
                            CornerRadius="6" Padding="12,6"
                            ClickMode="Press"
                            Cursor="Hand"
                            Click="ExitButton_Click">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <TextBlock Classes="icon" Text="{ci:LI X}" FontSize="15"
                                       Foreground="{Binding Chrome.ButtonForeground}" VerticalAlignment="Center"/>
                            <TextBlock Text="退出" FontSize="15" Foreground="{Binding Chrome.ButtonForeground}" VerticalAlignment="Center"/>
                        </StackPanel>
                        <Button.Styles>
                            <Style Selector="Button:pointerover">
                                <Setter Property="Background" Value="{Binding Chrome.ButtonHover}"/>
                            </Style>
                        </Button.Styles>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 左上角提醒面板（无边框无背景纯文字：未并入第一行的 降雨/倒计时/文本 + 预警。天气在顶部行主位，预警始终单开）
                 上边距是给玻璃留的：这一块与上面第一行各垫一块玻璃，玻璃各往外探 6px，
                 而这两行原本严丝合缝地贴着，两块玻璃就会叠出 12px 的错位边。
                 Margin 加在这一块上（面板是 VerticalAlignment=Top，所在行是 *，不影响任何别的东西的位置） -->
            <Border x:Name="ReminderPanel" Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Left" VerticalAlignment="Top"
                    Margin="0,16,0,0"
                    MaxWidth="{Binding ReminderPanelMaxWidth}" MaxHeight="400"
                    IsHitTestVisible="True">
                <Border.IsVisible>
                    <MultiBinding Converter="{x:Static converters:BoolConverters.Or}">
                        <Binding Path="ShowReminderPanel"/>
                        <Binding ElementName="GlassFallbackNotice" Path="IsVisible"/>
                    </MultiBinding>
                </Border.IsVisible>
                <ScrollViewer VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Spacing="8">
                        <Grid x:Name="GlassFallbackNotice" IsVisible="False" ColumnDefinitions="*,Auto" ColumnSpacing="6">
                            <TextBlock x:Name="GlassFallbackNoticeText" Foreground="{Binding Chrome.TextPrimary}"
                                       TextWrapping="Wrap" FontSize="15" VerticalAlignment="Center"/>
                            <Button Grid.Column="1" Content="×" Click="DismissGlassFallbackNotice_Click" ClickMode="Press"
                                    AutomationProperties.Name="关闭玻璃降级提示" ToolTip.Tip="关闭提示"
                                    Foreground="{Binding Chrome.ButtonForeground}" Background="{Binding Chrome.ButtonBackground}"
                                    BorderThickness="0" Padding="8,3" VerticalAlignment="Center"/>
                        </Grid>
                        <StackPanel Spacing="8" IsVisible="{Binding ShowReminderPanel}">
                            <!-- 降雨提醒（未并入第一行才在面板显示）：☔ + 主标题 + 小字号副标题，用降水色 -->
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowRainReminderPanel}">
                                <TextBlock Classes="icon" Text="{ci:LI CloudRain}" FontSize="20" VerticalAlignment="Center"
                                           Foreground="{Binding RainColorBrush}"/>
                                <TextBlock Text="{Binding RainReminderTitle}" FontSize="19" FontWeight="Bold"
                                           Foreground="{Binding RainColorBrush}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding RainSubtitle}" FontSize="12" Foreground="{Binding Chrome.TextSecondary}" VerticalAlignment="Center"
                                           IsVisible="{Binding HasRainSubtitle}"/>
                            </StackPanel>
                            <!-- 倒计时（未并入第一行才在面板显示） -->
                            <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding ShowCountdownPanel}">
                                <TextBlock Classes="icon" Text="{ci:LI Timer}" FontSize="20" VerticalAlignment="Center"
                                           Foreground="{Binding Chrome.TextPrimary}"/>
                                <TextBlock Text="{Binding CountdownText}" FontSize="19" FontWeight="Bold"
                                           Foreground="{Binding Chrome.Countdown}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                                <TextBlock Text="{Binding CountdownSubtitle}" FontSize="12" Foreground="{Binding Chrome.TextSecondary}" VerticalAlignment="Center"
                                           IsVisible="{Binding HasCountdownSubtitle}"/>
                            </StackPanel>
                            <!-- 文本（未并入第一行才在面板显示；跟随 CI 主界面文本组件） -->
                            <TextBlock Text="{Binding ReminderText}" FontSize="{Binding ReminderTextFontSize}"
                                       Foreground="{Binding ReminderTextBrush}"
                                       TextWrapping="Wrap" IsVisible="{Binding ShowTextPanel}"/>
                            <!-- 预警（排最下，区级统一发布按等级着色；点击标题右侧「>」在标题同一行右侧横向展开详情全文） -->
                            <StackPanel Spacing="3" IsVisible="{Binding ShowAlertsRow}">
                                <ItemsControl ItemsSource="{Binding AlertItems}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <!-- 悬停该条预警即在顶部弹幕带循环滚动其详情、移开即消失；
                                                 点击则滚一整遍后自动收起（没滚完时重复点击不生效） -->
                                            <StackPanel Orientation="Horizontal" Spacing="5"
                                                        Cursor="Hand"
                                                        PointerEntered="AlertPointerEntered" PointerExited="AlertPointerExited"
                                                        PointerPressed="AlertPointerPressed">
                                                <TextBlock Classes="icon" Text="{Binding Icon}" FontSize="{Binding IconFontSize}"
                                                           Foreground="{Binding Foreground}" VerticalAlignment="Center"/>
                                                <TextBlock Text="{Binding DisplayText}" Foreground="{Binding Foreground}"
                                                           FontSize="{Binding FontSize}" FontWeight="Bold" TextWrapping="Wrap"/>
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!-- 记录规则：鼠标悬停计数区域时在其上方弹出。独立浮层（Popup 不占布局），
                 避免规则出现/消失导致计数区上下位移、鼠标反复脱离引发的排版抖动 -->
            <Popup x:Name="RulesPopup"
                   Placement="Top"
                   VerticalOffset="-8"
                   IsOpen="{Binding ShowCountRules}"
                   IsLightDismissEnabled="False">
                <Border Background="{Binding Chrome.PopupBackground}" CornerRadius="10" Padding="16,10"
                        BorderBrush="{Binding Chrome.PopupBorder}" BorderThickness="1" MaxWidth="720">
                    <TextBlock Text="{Binding CountRulesText}"
                               FontSize="13" Foreground="{Binding Chrome.PopupText}"
                               TextAlignment="Center" TextWrapping="Wrap"/>
                </Border>
            </Popup>
        </Grid>

        <!-- 底部全宽「底边进度带」：固定贴窗口最底部、横向铺满全屏，亮色已完成 + 深蓝低饱和剩余 -->
        <ProgressBar Grid.Row="1" Minimum="0" Maximum="100" Value="{Binding CourseProgress}"
                     Height="6" IsVisible="{Binding ShowCourseProgress}"
                     Foreground="{Binding ProgressFillBrush}" Background="{Binding ProgressTrackBrush}">
            <ProgressBar.Template>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border x:Name="PART_Track" Background="{TemplateBinding Background}"/>
                        <!-- 同音量条：不定 Left 的话，定宽 + 拉伸会被居中，进度带整体偏右半格 -->
                        <Border x:Name="PART_Indicator" HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"/>
                    </Grid>
                </ControlTemplate>
            </ProgressBar.Template>
        </ProgressBar>
        </Grid>

        <!-- 快速设置：从可见区域一侧贴边滑出的一块面板，内容就是 CI 设置页左栏那一份，
             不另做一套 UI（同一个 SettingsPage，Embedded 模式藏掉右栏预览）。
             面板只占「顶栏以下、按钮行以上」那一段，不压日期也不盖按钮（位置在 code-behind 里算）。
             用半透明遮罩分隔面板和大屏；拖动设置项时减淡，方便查看后方布局。
             放在地震提醒下面：预警弹出来时仍然压过设置面板。 -->
        <Grid x:Name="QuickSettingsOverlay" Grid.Row="0" Grid.RowSpan="2"
              IsVisible="False"
              PointerPressed="QuickSettingsOverlay_PointerPressed">
            <Border x:Name="QuickSettingsVeil" Background="#33000000" IsHitTestVisible="False"/>
            <!-- 整屏压暗只负责画；点击关闭的区域真正避开顶栏和按钮行。
                 根 Grid 没有背景，这两处输入可直接命中原控件，不需要转发/重放事件。 -->
            <Border x:Name="QuickSettingsDismissArea" Background="Transparent" Margin="0,20,0,20"/>
            <!-- 面板底不用 CI 的 CardBackgroundFillColor：深色主题下那个只有 5% 白，
                 压在一张亮背景图上等于没有，白字根本读不出来。这里定死实底深色，
                 里面再套一层深色主题作用域，文字与控件都按浅色渲染，任何背景图上都清楚。 -->
            <Border x:Name="QuickSettingsCard"
                    HorizontalAlignment="Right" VerticalAlignment="Stretch"
                    Width="440" Margin="0,20,20,20"
                    Background="#F21A1A22"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1" CornerRadius="12"
                    ClipToBounds="True">
                <ThemeVariantScope RequestedThemeVariant="Dark">
                    <Grid x:Name="QuickSettingsHost"/>
                </ThemeVariantScope>
            </Border>
        </Grid>

        <Border x:Name="AboutShade" Grid.RowSpan="2" Background="#36000000"
                IsVisible="False" IsHitTestVisible="False"/>

        <!-- 地震提醒：整屏正中弹出（内容读自「地震预警」插件，见 EarthquakeReader）。
             这一层压在全部内容上面、跨两行、不吃鼠标事件。
             弹出时整块屏幕先被一层磨砂蒙住（QuakeSheet），别的什么都看不清，只剩正中这张卡片——
             预警的最高重要性就是这么来的；卡片自己的磨砂也是从同一张模糊图上裁的（FrostedCardBackdrop）。
             磨砂用的是背景层早烘好的那张模糊图，不再对整屏做一次实时模糊：
             4K 上后者每次重绘几十毫秒，而这张图是现成的，只多画一遍。
             第一行是横波倒计时、第二行是震中和震级，等级色（本地烈度分档）用在文字、描边和底色上；
             字号随时钟字号缩放，再长由 Viewbox 等比缩，保证整屏塞得下。 -->
        <Grid x:Name="EarthquakeAlertLayer" Grid.Row="0" Grid.RowSpan="2"
              IsHitTestVisible="False" IsVisible="{Binding ShowEarthquakeAlert}">
            <!-- 兜底：没有背景图、也就没有模糊图时，靠这层近乎不透明的底色把别的盖掉 -->
            <Border x:Name="QuakeVeil"/>
            <!-- 整屏磨砂：有模糊图时它盖掉 QuakeVeil，整块屏幕变成一张磨砂玻璃 -->
            <views:FrostedCardBackdrop x:Name="QuakeSheet" Radius="0"/>
            <Border x:Name="EarthquakeAlertBlock"
                    HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{Binding EarthquakeAlertBackground}"
                    BorderBrush="{Binding EarthquakeAlertBorder}"
                    BorderThickness="2" CornerRadius="14">
                <Panel>
                    <!-- 磨砂底：有背景图时盖掉上面的纯色底，没图时（画不出）就留着纯色底兜底 -->
                    <views:FrostedCardBackdrop x:Name="EqFrost" Radius="12"
                                               Tint="{Binding EarthquakeAlertBackground}"/>
                    <Viewbox Margin="30,18" Stretch="Uniform" StretchDirection="DownOnly"
                             MaxWidth="{Binding EarthquakeAlertMaxWidth}"
                             HorizontalAlignment="Center" VerticalAlignment="Center">
                        <StackPanel Spacing="6" HorizontalAlignment="Center">
                            <TextBlock Text="{Binding EarthquakeLine1}"
                                       FontSize="{Binding EarthquakeLine1FontSize}" FontWeight="Bold"
                                       Foreground="{Binding EarthquakeAlertBrush}"
                                       HorizontalAlignment="Center" TextWrapping="NoWrap"/>
                            <TextBlock Text="{Binding EarthquakeLine2}"
                                       FontSize="{Binding EarthquakeLine2FontSize}" FontWeight="Bold"
                                       Foreground="{Binding EarthquakeAlertBrush}"
                                       HorizontalAlignment="Center" TextWrapping="NoWrap"/>
                        </StackPanel>
                    </Viewbox>
                </Panel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
